[Unit]
Description=restic off-device backup of /home to Backblaze B2
Documentation=file:///home/brandonrobertniehaus/dotfiles/SETUP-NOTES.md
Wants=network-online.target
# systemd-suspend.service: Persistent=true fires on wake; starting *during*
# resume makes systemd-inhibit EALREADY (2026-08-24 08:31 brandon-fedora).
After=network-online.target systemd-suspend.service

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/b2-home.env
# Installed copy in a system path: systemd (init_t) cannot exec a user_home_t
# file under enforcing SELinux. Source of truth is dotfiles/scripts/backup-home.sh.
# Inhibit lives *inside* the script (with EALREADY fallback). Do not wrap
# ExecStart in systemd-inhibit: a Persistent catch-up mid-resume then fails
# in 4ms and skips the day's snapshot (2026-08-24).
# Daily incrementals are small; the 2h timeout still bounds a wedged run.
# A multi-hour first/gap catch-up must still bypass this unit and run
# `systemd-inhibit ... /usr/local/sbin/restic-backup-home.sh` by hand.
ExecStart=/usr/local/sbin/restic-backup-home.sh
# be gentle on an interactive laptop
Nice=10
IOSchedulingClass=idle
# a backup should never wedge the machine indefinitely
TimeoutStartSec=2h
