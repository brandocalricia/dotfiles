#!/usr/bin/env bash
# cck — Claude Code running on Kimi K3, as OVERFLOW for the Pro plan.
#
# Why this is a separate launcher and not a settings.json change:
# putting ANTHROPIC_BASE_URL in ~/.claude/settings.json routes *every* session
# to Moonshot — including the Obsidian brain hooks and any agent you didn't mean
# to move. This way `claude` stays on the Anthropic plan and `cck` is opt-in per
# terminal, so nothing silently changes underneath you.
#
# On the economics: metered K3 is NOT cheaper than a Pro subscription for this
# workload. Measured usage for Jul 7 – Aug 5 was ~291M tokens (96% cache reads),
# which prices at roughly $155/mo on Moonshot's $3/$15/$0.30 card versus $20 for
# Pro. Use cck when Pro is rate-limited, not to replace it.
set -uo pipefail

# Pick the key up even when the caller isn't an interactive zsh — a bare `sh -c`,
# a systemd unit, or anything Hyprland spawns never sources ~/.zshrc.
if [ -z "${MOONSHOT_API_KEY:-}" ] && [ -f "$HOME/.config/secrets.env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.config/secrets.env"
fi

case "${MOONSHOT_API_KEY:-}" in
  ""|PASTE_YOUR_KIMI_KEY_HERE)
    cat >&2 <<'EOF'
cck: MOONSHOT_API_KEY is not set.

  1. Get a key at https://platform.kimi.ai/console/api-keys
     (sign in -> User Center -> API Keys -> create)
  2. Put it in ~/.config/secrets.env — already sourced by ~/.zshrc, and
     deliberately outside ~/dotfiles, which auto-commits and pushes:
       export MOONSHOT_API_KEY="sk-..."
  3. source ~/.config/secrets.env   (or open a new terminal)
EOF
    exit 1
    ;;
esac

# `cck --check` — verify the account before blaming Claude Code. Two failure
# modes look identical from inside the TUI: a zero balance and a model the
# account cannot see. Both surface here in one call.
if [ "${1:-}" = "--check" ]; then
  echo "checking account..." >&2
  models=$(curl -s --max-time 20 https://api.moonshot.ai/v1/models \
    -H "Authorization: Bearer $MOONSHOT_API_KEY")
  if [ -z "$models" ]; then echo "cck: no response from api.moonshot.ai" >&2; exit 1; fi
  if printf '%s' "$models" | grep -q '"error"'; then
    printf '%s\n' "$models" | jq -r '.error.message // .' >&2; exit 1
  fi
  echo "models available to this key:" >&2
  printf '%s' "$models" | jq -r '.data[] | "  \(.id)  ctx=\(.context_length)"' >&2
  want="${KIMI_MODEL:-kimi-k3}"; want="${want%%[*}"
  if printf '%s' "$models" | jq -e --arg m "$want" '.data[] | select(.id==$m)' >/dev/null 2>&1; then
    echo "configured model '$want' is available." >&2
  else
    echo "WARNING: configured model '$want' is NOT in the list above." >&2
    echo "  Set a different one:  KIMI_MODEL='kimi-k2.7-code' cck" >&2
  fi
  echo "sending a 1-token test..." >&2
  r=$(curl -s --max-time 45 https://api.moonshot.ai/anthropic/v1/messages \
    -H "Authorization: Bearer $MOONSHOT_API_KEY" -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d "{\"model\":\"$want\",\"max_tokens\":8,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}")
  if printf '%s' "$r" | grep -q '"error"'; then
    printf 'FAILED: %s\n' "$(printf '%s' "$r" | jq -r '.error.message // .')" >&2; exit 1
  fi
  echo "OK — account is funded and '$want' responds." >&2
  exit 0
fi

# kimi-k3 thinks by default and works as-is. kimi-k2.7-code requires thinking to
# be enabled explicitly (Tab in the TUI) or requests fail outright.
export ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"
export ANTHROPIC_AUTH_TOKEN="$MOONSHOT_API_KEY"
export ANTHROPIC_MODEL="${KIMI_MODEL:-kimi-k3}"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$ANTHROPIC_MODEL"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$ANTHROPIC_MODEL"
export CLAUDE_CODE_SUBAGENT_MODEL="$ANTHROPIC_MODEL"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1048576"

# An API key set here would outrank the auth token and break the Moonshot call.
unset ANTHROPIC_API_KEY

echo "cck: $ANTHROPIC_MODEL via api.moonshot.ai  (metered — \$3/\$15 per MTok)" >&2
echo "cck: verify inside with /status; your brain hooks run unchanged." >&2

exec claude "$@"
