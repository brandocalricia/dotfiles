* {
    font-family: "JetBrainsMono Nerd Font", "JetBrainsMono NF", "Font Awesome 6 Free", "WaybarAppIcons", monospace;
    font-size: 13px;
    font-weight: 500;
    min-height: 0;
    border: none;
    border-radius: 0;
}
window#waybar {
    background: transparent;
    color: #e8d9b8;
}
.modules-left, .modules-center, .modules-right {
    background: #1a1612;
    border: 1px solid #2a1f1a;
    border-radius: 10px;
    margin: 6px 4px;
    padding: 0 6px;
}
#workspaces { padding: 0 4px; }
/* base = occupied: bright chip so windows-elsewhere are visible at a glance */
#workspaces button {
    padding: 0 10px;
    margin: 4px 3px;
    font-size: 15px;
    color: #e8d9b8;
    background: #2a1f1a;
    border-radius: 6px;
    transition: all 0.2s ease;
}
/* empty persistent workspaces: dim, no chip */
#workspaces button.empty {
    color: #8a7a5e;
    background: transparent;
}
/* active must come after .empty: an empty focused workspace has both classes */
#workspaces button.active {
    color: #1a1612;
    background: #c89412;
}
#workspaces button.urgent {
    color: #1a1612;
    background: #8a0e09;
}
#workspaces button:hover {
    background: #3d0d0a;
    color: #e8d9b8;
}
/* Idle text/icons use the occupied-workspace cream. Semantic states keep accents. */
/* thinking-orbs: 20px inline orb after workspace 10, inside the left group. */
#image.agent-orb {
    background: transparent;
    padding: 0 8px 0 2px;
    margin: 4px 0;
}
#clock {
    padding: 0 14px;
    color: #e8d9b8;
    font-weight: 600;
}
#cpu, #memory, #disk, #network, #pulseaudio, #battery, #custom-dropbox, #custom-caffeine, #tray {
    padding: 0 10px;
    margin: 4px 3px;
    background: #2a1f1a;
    color: #e8d9b8;
    border-radius: 6px;
    transition: all 0.2s ease;
}
#cpu:hover, #memory:hover, #disk:hover, #network:hover, #pulseaudio:hover, #battery:hover, #custom-dropbox:hover, #custom-caffeine:hover {
    background: #3d0d0a;
}
/* caffeine keep-awake toggle: roomy chip, cup + ON/off so the state is obvious */
#custom-caffeine {
    min-width: 4.8em;
    padding: 0 14px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
}
#custom-caffeine.inactive { color: #e8d9b8; }
#custom-caffeine.active {
    color: #1a1612;
    background: #c89412;
}
#pulseaudio.muted { color: #8a0e09; }
#battery.warning { color: #d4a13a; }
#battery.critical { color: #8a0e09; }
#tray { padding: 0 8px; }
#custom-dropbox.syncing { color: #d4a13a; }
#custom-dropbox.starting { color: #d4a13a; }
#custom-dropbox.paused { color: #8a7a5e; }
#custom-dropbox.error { color: #8a0e09; }
menu {
    background: #1a1612;
    border: 1px solid #521510;
    border-radius: 8px;
    padding: 4px;
}
menuitem {
    color: #e8d9b8;
    padding: 4px 12px;
    border-radius: 4px;
}
menuitem:hover {
    background: #3d0d0a;
}
tooltip {
    background: #1a1612;
    border: 1px solid #521510;
    border-radius: 8px;
    color: #e8d9b8;
    padding: 4px;
}
