* {
    font-family: "JetBrainsMono Nerd Font", "JetBrainsMono NF", "Font Awesome 6 Free", "WaybarAppIcons", monospace;
    font-size: 13px;
    font-weight: 500;
    min-height: 0;
    border: none;
    border-radius: 0;
}
window#waybar {
    background: transparent;
    color: #e8d9b8;
}
/* Sections are only layout. Modules are flat chips: fill and spacing, no stroke. */
.modules-left,
.modules-center,
.modules-right {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}
#workspaces {
    background: transparent;
    border: none;
    margin: 0 0 0 4px;
    padding: 0;
}
/* One chip per workspace. Padding keeps the number and icon off the edge. */
#workspaces button {
    padding: 5px 12px;
    margin: 5px 4px;
    min-width: 0;
    font-size: 15px;
    color: #e8d9b8;
    background: #2a1f1a;
    border: none;
    border-radius: 8px;
    transition: all 0.2s ease;
}
#workspaces button.empty {
    color: #8a7a5e;
    background: #1a1612;
    border: none;
}
/* active must come after .empty: an empty focused workspace has both classes */
#workspaces button.active {
    color: #1a1612;
    background: #c89412;
    border: none;
}
#workspaces button.urgent {
    color: #1a1612;
    background: #8a0e09;
    border: none;
}
#workspaces button:hover {
    background: #3d0d0a;
    color: #e8d9b8;
    border: none;
}
/* Idle text/icons use the occupied-workspace cream. Semantic states keep accents. */
#clock {
    background: #1a1612;
    border: none;
    border-radius: 8px;
    margin: 6px 0;
    padding: 0 14px;
    color: #e8d9b8;
    font-weight: 600;
}
#cpu, #memory, #disk, #network, #pulseaudio, #battery, #custom-dropbox, #custom-caffeine, #tray {
    padding: 0 8px;
    margin: 6px 3px;
    background: #2a1f1a;
    color: #e8d9b8;
    border: none;
    border-radius: 8px;
    transition: all 0.2s ease;
}
#cpu:hover, #memory:hover, #disk:hover, #network:hover, #pulseaudio:hover, #battery:hover, #custom-dropbox:hover, #custom-caffeine:hover {
    background: #3d0d0a;
    border: none;
}
/* caffeine keep-awake toggle: roomy chip, cup + ON/off so the state is obvious */
#custom-caffeine {
    min-width: 4.6em;
    padding: 0 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
}
#custom-caffeine.inactive { color: #e8d9b8; }
#custom-caffeine.active {
    color: #1a1612;
    background: #c89412;
    border: none;
}
#pulseaudio.muted { color: #8a0e09; }
#battery.warning { color: #d4a13a; }
#battery.critical { color: #8a0e09; }
#tray {
    padding: 0 8px;
    margin: 6px 4px 6px 3px;
}
/* Font Awesome dropbox mark sits right of its box. Extra right padding centers it. */
#custom-dropbox { padding: 0 10px 0 6px; }
#custom-dropbox.syncing { color: #d4a13a; }
#custom-dropbox.starting { color: #d4a13a; }
#custom-dropbox.paused { color: #8a7a5e; }
#custom-dropbox.error { color: #8a0e09; }
menu {
    background: #1a1612;
    border: none;
    border-radius: 8px;
    padding: 4px;
}
menuitem {
    color: #e8d9b8;
    padding: 4px 12px;
    border-radius: 4px;
}
menuitem:hover {
    background: #3d0d0a;
}
tooltip {
    background: #1a1612;
    border: none;
    border-radius: 8px;
    color: #e8d9b8;
    padding: 4px;
}
