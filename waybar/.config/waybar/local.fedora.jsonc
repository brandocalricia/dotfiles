{
    // Per-machine waybar overrides for this host (Framework Laptop 13).
    // local.jsonc is gitignored — each machine maintains its own copy.
    // config.jsonc `include`s this file; modules-right lives here so this
    // laptop keeps "battery" while a battery-less desktop omits it.
    //
    // t474u/t475u: no custom/gb chip by the clock. Mass GB Zellij on workspace 1
    // uses office-building-cog + cyan chip (window-rewrite + #workspaces button#1).
    // Status: gb-waybar.py or `python3 ~/.grok/agent-city/bus.py status`.
    "modules-right": ["custom/caffeine", "custom/dropbox", "network", "pulseaudio", "cpu", "memory", "disk", "battery", "tray"]
}
